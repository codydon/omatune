#!/usr/bin/bash
# YouTube Music backend for the codydon.omatune plugin.
#
# Talks to YouTube Music's InnerTube API anonymously (the WEB_REMIX client, the
# same one music.youtube.com uses when you are signed out) for search and
# radio, and execs the mpv process that plays audio. Stream
# resolution, signature deobfuscation and PoTokens are left to yt-dlp, which
# mpv calls through its ytdl_hook.
#
#   ytm-backend search <query> [all|songs|videos]
#                                  -> {"ok":true,"tracks":[...],"didYouMean":"","showingFor":""}
#   ytm-backend suggest <query>    -> {"ok":true,"suggestions":[...]}
#   ytm-backend radio <videoId>    -> {"ok":true,"tracks":[...]}
#   ytm-backend player             -> execs mpv (never returns on success)
#
# search and radio print exactly one line of JSON on stdout, including on
# failure. The Service runs every call under `timeout -k`, so the whole
# process group (curl, jq, head) is killed at the deadline.
set -euo pipefail
umask 077
export LC_ALL=C

readonly CURL=/usr/bin/curl
readonly JQ=/usr/bin/jq
readonly MPV=/usr/bin/mpv
readonly YTDLP=/usr/bin/yt-dlp
readonly HEAD=/usr/bin/head
readonly CAT=/usr/bin/cat

readonly API=https://music.youtube.com/youtubei/v1
readonly CLIENT_NAME=WEB_REMIX
readonly CLIENT_VERSION=1.20250101.01.00
# Search filters. With none, YouTube returns its top result plus a few of
# each kind (songs, videos, albums, artists); these return one kind only.
# Many tracks (live cuts, regional releases, uploads by small artists) exist
# only as videos, so "all" also has to cover videos.
readonly SONGS_PARAMS='EgWKAQIIAWoKEAkQBRAKEAMQBA%3D%3D'
readonly VIDEOS_PARAMS='EgWKAQIQAWoKEAkQChAFEAMQBA%3D%3D'

readonly MAX_RESPONSE=$((4 * 1024 * 1024))
readonly MAX_QUERY=200
readonly MAX_TRACKS=40
readonly MAX_SUGGESTIONS=8

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"
readonly RUNTIME_DIR="$XDG_RUNTIME_DIR/codydon-omatune"
readonly SOCKET="$RUNTIME_DIR/mpv.sock"
# mpv-mpris gives media keys and the Omarchy media widget. Loaded
# explicitly because --no-config skips the system script directory.
readonly MPRIS_SCRIPT=/etc/mpv/scripts/mpris.so

reply_error() {
  "$JQ" -cn --arg e "$1" '{ok: false, error: $e}'
  exit 0
}

ensure_runtime_dir() {
  install -d -m 700 -- "$RUNTIME_DIR"
  chmod 700 -- "$RUNTIME_DIR"
  [[ -O $RUNTIME_DIR && ! -L $RUNTIME_DIR ]] || reply_error "The runtime directory is not owned by you."
}

# POST a JSON body (read from stdin) to an InnerTube endpoint. The response is
# capped at the producer: head reads one byte past the limit so an oversized
# reply is detected instead of silently truncated into invalid JSON.
innertube() {
  local endpoint=$1 body
  body=$("$CURL" -q --silent --show-error --fail --proto '=https' \
      --max-time 15 --connect-timeout 5 --max-filesize "$MAX_RESPONSE" \
      -H 'Content-Type: application/json' \
      -H 'Origin: https://music.youtube.com' \
      --data-binary @- -- "$API/$endpoint?prettyPrint=false" \
    | "$HEAD" -c $((MAX_RESPONSE + 1))) || return 1
  (( ${#body} <= MAX_RESPONSE )) || return 1
  printf '%s' "$body"
}

context_json() {
  "$JQ" -cn --arg name "$CLIENT_NAME" --arg ver "$CLIENT_VERSION" \
    '{client: {clientName: $name, clientVersion: $ver, hl: "en", gl: "US"}}'
}

valid_video_id() {
  [[ $1 =~ ^[A-Za-z0-9_-]{11}$ ]]
}

# Shared jq helpers: every string is stripped of control characters and
# capped, every id is shape-checked, and the list is capped, so the QML side
# receives a small, strictly shaped document whatever YouTube sends.
readonly JQ_HELPERS='
  def clean($n): tostring | gsub("[\\x00-\\x1f\\x7f\\x{202a}-\\x{202e}\\x{2066}-\\x{2069}]"; "") | .[0:$n];
  def okid: type == "string" and test("^[A-Za-z0-9_-]{11}$");
  def okdur: if type == "string" and test("^[0-9]{1,2}(:[0-9]{2}){1,2}$") then . else "" end;
  def runs_text: (.runs // []) | map(.text // "") | join("");
'

# POST one search, optionally with a filter. Prints the raw response.
search_request() {
  "$JQ" -cn --argjson ctx "$(context_json)" --arg q "$1" --arg p "$2" \
      '{context: $ctx, query: $q} + (if $p == "" then {} else {params: $p} end)' \
    | innertube search
}

# Turns one to three search responses (slurped into an array) into tracks.
# Rows are musicResponsiveListItemRenderer: column 0 is the title, column 1
# is "Song • Artist • Album • 3:45" (unfiltered) or "Artist • Album • 3:45"
# (filtered); videos carry "1.2M views" instead of an album. The top result
# is a musicCardShelfRenderer with the same text in its subtitle.
# Order: the top result, then each response's rows in page order (YouTube's
# ranking), response by response. A track that shows up twice keeps its
# first place and gains a missing duration or album. $kinds[i] is the kind
# to assume for an unlabeled row in response i.
readonly JQ_SEARCH='
  def counts: test("^[0-9][0-9.,]*[KMB]? (views?|plays?)$");
  def track($id; $title; $meta; $default):
    ($meta | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $m
    | (if ($m[0] // "") | IN("Song", "Video", "Episode", "Podcast", "Artist", "Album", "Single", "EP", "Playlist", "Profile")
        then $m[0] else "" end) as $label
    | ($m | if $label != "" then .[1:] else . end | map(select(counts | not))) as $rest
    | (($rest[-1] // "") | okdur) as $dur
    | ($rest | if $dur != "" then .[0:-1] else . end) as $rest
    | (if $label == "Song" then "song" elif $label == "Video" then "video" elif $label != "" then "other"
       elif any($m[]; test("views?$")) then "video" else $default end) as $kind
    | select($kind == "song" or $kind == "video")
    | { id: $id, kind: $kind, title: ($title | clean(200)),
        artist: (($rest[0] // "") | clean(120)),
        album: (if $kind == "song" and ($rest | length) > 1 then $rest[1] | clean(120) else "" end),
        duration: $dur };
  def row($default):
    select(.playlistItemData.videoId | okid)
    | track(.playlistItemData.videoId;
        (.flexColumns[0].musicResponsiveListItemFlexColumnRenderer.text | runs_text);
        (.flexColumns[1].musicResponsiveListItemFlexColumnRenderer.text | runs_text | split(" • "));
        $default);
  def top:
    [ .. | objects | select(has("musicCardShelfRenderer")) | .musicCardShelfRenderer
      | (.title.runs[0].navigationEndpoint.watchEndpoint.videoId) as $id | select($id | okid)
      | track($id; (.title | runs_text); (.subtitle | runs_text | split(" • ")); "song") ];
  def rows($default):
    [ .. | objects | select(has("musicResponsiveListItemRenderer")) | .musicResponsiveListItemRenderer | row($default) ];
  def correction:
    first(.. | objects | select(has("didYouMeanRenderer") or has("showingResultsForRenderer"))) // {}
    | if has("didYouMeanRenderer") then
        { didYouMean: (.didYouMeanRenderer | (.correctedQueryEndpoint.searchEndpoint.query // (.correctedQuery | runs_text)) | clean(200)) }
      elif has("showingResultsForRenderer") then
        { showingFor: (.showingResultsForRenderer | (.correctedQueryEndpoint.searchEndpoint.query // (.correctedQuery | runs_text)) | clean(200)) }
      else {} end;
  def card_ids:
    [ .. | objects | select(has("musicCardShelfRenderer")) | .musicCardShelfRenderer.contents[]?
      | .musicResponsiveListItemRenderer.playlistItemData.videoId? // empty ];
  . as $docs | ($kinds | split(",")) as $k
  | ($docs[0] | card_ids) as $card
  | [range($docs | length) as $i | $docs[$i] | rows($k[$i] // "song")] as $lists
  # The rows tucked under the top result are mostly re-uploads of it; they
  # go after the rest of the first page.
  | ($docs[0] | top)
    + (($lists[0] // []) | map(select(.id as $id | $card | index($id) | not)))
    + (($lists[0] // []) | map(select(.id as $id | $card | index($id))))
    + ($lists[1:] | add // [])
  | reduce .[] as $t ([];
      (map(.id) | index($t.id)) as $i
      | if $i == null then . + [$t]
        else .[$i] |= (if .duration == "" then .duration = $t.duration else . end
                       | if .album == "" and .kind == $t.kind then .album = $t.album else . end) end)
  | .[0:$max]
  | {ok: true, tracks: ., didYouMean: "", showingFor: ""} + ($docs[0] | correction)
'

cmd_search() {
  local query=${1:-} filter=${2:-all}
  [[ -n $query ]] || reply_error "Type something to search for."
  (( ${#query} <= MAX_QUERY )) || reply_error "That search is too long."
  [[ $query != *[[:cntrl:]]* ]] || reply_error "That search has characters YouTube can't take."

  local main songs="" videos="" kinds songs_fd videos_fd
  case $filter in
    all)
      # The unfiltered search finds the top result and YouTube's ranking
      # across kinds; the songs and videos searches fill the list and
      # supply durations the unfiltered rows leave out. All three run at once.
      exec {songs_fd}< <(search_request "$query" "$SONGS_PARAMS" || true)
      exec {videos_fd}< <(search_request "$query" "$VIDEOS_PARAMS" || true)
      main=$(search_request "$query" "") || main=""
      songs=$("$CAT" <&"$songs_fd") || songs=""
      videos=$("$CAT" <&"$videos_fd") || videos=""
      exec {songs_fd}<&- {videos_fd}<&-
      # jq -s skips empty responses, so list kinds for the ones that remain.
      kinds=song
      [[ -n $songs ]] && kinds+=,song
      [[ -n $videos ]] && kinds+=,video
      if [[ -z $main ]]; then main=$songs; songs=""; kinds=${kinds#song,}; fi ;;
    songs) main=$(search_request "$query" "$SONGS_PARAMS") || main=""; kinds=song ;;
    videos) main=$(search_request "$query" "$VIDEOS_PARAMS") || main=""; kinds=video ;;
    *) reply_error "Unknown search filter. Use all, songs or videos." ;;
  esac
  [[ -n $main ]] || reply_error "Couldn't reach YouTube Music. Check your connection, then search again."

  # Empty responses are skipped, so a failed side search just means fewer rows.
  printf '%s\n' "$main" "$songs" "$videos" \
    | "$JQ" -cs --argjson max "$MAX_TRACKS" --arg kinds "$kinds" "$JQ_HELPERS$JQ_SEARCH" 2>/dev/null \
    || reply_error "YouTube Music answered with something unexpected. Try again in a moment."
}

cmd_suggest() {
  local query=${1:-}
  if [[ -z $query ]]; then "$JQ" -cn '{ok: true, suggestions: []}'; return; fi
  (( ${#query} <= MAX_QUERY )) || reply_error "That search is too long."
  [[ $query != *[[:cntrl:]]* ]] || reply_error "That search has characters YouTube can't take."

  local response
  response=$("$JQ" -cn --argjson ctx "$(context_json)" --arg q "$query" \
      '{context: $ctx, input: $q}' \
    | innertube music/get_search_suggestions) || reply_error "Couldn't reach YouTube Music. Check your connection, then search again."

  # Suggestion rows carry the completed query to run plus the display text
  # split into runs; prefer the completed query and clean it like the rest.
  printf '%s' "$response" | "$JQ" -c --argjson max "$MAX_SUGGESTIONS" "$JQ_HELPERS"'
    [ .. | objects | select(has("searchSuggestionRenderer")) | .searchSuggestionRenderer
      | (.navigationEndpoint.searchEndpoint.query // "") as $q
      | ([.suggestion.runs[]? | .text // ""] | add // "") as $t
      | (if ($q | type) == "string" and $q != "" then $q else $t end | clean(200))
      | select(. != "") ]
    | reduce .[] as $s ([]; if any(.[]; . == $s) then . else . + [$s] end)
    | .[0:$max]
    | {ok: true, suggestions: .}' 2>/dev/null || reply_error "YouTube Music answered with something unexpected. Try again in a moment."
}

cmd_radio() {
  local id=${1:-}
  valid_video_id "$id" || reply_error "That isn't a YouTube video id."

  local response
  response=$("$JQ" -cn --argjson ctx "$(context_json)" --arg id "$id" \
      '{context: $ctx, videoId: $id, playlistId: ("RDAMVM" + $id), isAudioOnly: true}' \
    | innertube next) || reply_error "Couldn't load a radio for this song. Check your connection, then try again."

  printf '%s' "$response" | "$JQ" -c --argjson max "$MAX_TRACKS" "$JQ_HELPERS"'
    [ .. | objects | select(has("playlistPanelVideoRenderer")) | .playlistPanelVideoRenderer
      | select(.videoId | okid)
      | { id: .videoId,
          title: (.title.runs // [] | map(.text) | join("") | clean(200)),
          artist: ((.longBylineText.runs // [] | map(.text) | join("") | split(" • ")[0] // "") | clean(120)),
          album: "",
          duration: ((.lengthText.runs[0].text // "") | okdur) } ]
    | reduce .[] as $t ([]; if any(.[]; .id == $t.id) then . else . + [$t] end)
    | .[0:$max]
    | {ok: true, tracks: .}' 2>/dev/null || reply_error "YouTube Music answered with something unexpected. Try again in a moment."
}

# Replaces this script with mpv, so the plugin's Process owns mpv directly:
# no detaching, no pid file, and mpv stops when the plugin or shell stops.
# mpv listens on a socket in the 0700 runtime directory; it replaces a stale
# socket file itself.
cmd_player() {
  ensure_runtime_dir
  # 0.1.0 kept a log and a pid file here; remove exactly those two names.
  rm -f -- "$RUNTIME_DIR/mpv.log" "$RUNTIME_DIR/mpv.pid"
  [[ ! -e $SOCKET || -S $SOCKET ]] || reply_error "Something that isn't a socket is in the way at $SOCKET."
  local extra=()
  [[ -f $MPRIS_SCRIPT ]] && extra+=(--scripts="$MPRIS_SCRIPT")
  # The script runs under LC_ALL=C for byte-exact checks; mpv and yt-dlp
  # need a UTF-8 locale for titles.
  unset LC_ALL
  export LANG=C.UTF-8
  exec "$MPV" "${extra[@]}" \
    --idle=yes --no-video --force-window=no --no-terminal --no-config \
    --input-ipc-server="$SOCKET" \
    --ytdl-format='bestaudio/best' \
    --script-opts="ytdl_hook-ytdl_path=$YTDLP" \
    --prefetch-playlist=yes --cache=yes \
    --title='OmaTune' \
    --msg-level=all=no
}

main() {
  local cmd=${1:-}
  shift || true
  case $cmd in
    search) cmd_search "$@" ;;
    suggest) cmd_suggest "$@" ;;
    radio) cmd_radio "$@" ;;
    player) cmd_player ;;
    *) reply_error "Unknown command. Use search, suggest, radio or player." ;;
  esac
}

main "$@"
